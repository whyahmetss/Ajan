# Bu dosyanın adını ".env" yap ve bilgileri doldur. Bu dosyayı KİMSEYLE paylaşma.

# MT5 demo hesap bilgileri (MT5 terminali zaten açık ve girişliyse boş bırakabilirsin)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5 terminal64.exe yolu (birden fazla MT5 kuruluysa doldur)
MT5_PATH=

# Claude API anahtarı: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Grok (xAI) API anahtarı: https://console.x.ai
XAI_API_KEY=
